rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.userrole == 'ADMIN'; }

    match /books/{bookId} {
      allow read: if true;
      allow write: if admin();
    }
    match /authors/{authorId} {
      allow read: if true;
      allow write: if admin() || (signedIn() && request.resource.data.user_id == request.auth.uid);
    }
    match /profiles/{userId} {
      allow read: if admin() || (signedIn() && request.auth.uid == userId);
      allow create, update: if admin() || (signedIn() && request.auth.uid == userId);
      allow delete: if admin() || (signedIn() && request.auth.uid == userId);
    }
    match /orders/{orderId} {
      allow read: if admin() || (signedIn() && resource.data.user_id == request.auth.uid);
      allow create, update: if admin();
    }
    match /payments/{paymentId} {
      allow read: if admin();
      allow write: if admin();
    }
    match /private_book_files/{fileId} {
      allow read, write: if admin();
    }
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if admin() || (signedIn() && resource.data.user_id == request.auth.uid);
    }
    match /layout_settings/{settingId} {
      allow read: if true;
      allow write: if admin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}