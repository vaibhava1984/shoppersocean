{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shoppersocean",
  "main": "custom-worker.ts",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "shoppersocean.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "B2_BUCKET": "Shoppers-ocean-books",
    "B2_ENDPOINT": "s3.us-west-004.backblazeb2.com",
    "B2_REGION": "us-west-004"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shoppers-ocean-db"
    }
  ],
  "previews": {
    "vars": {
      "B2_BUCKET": "Shoppers-ocean-books",
      "B2_ENDPOINT": "s3.us-west-004.backblazeb2.com",
      "B2_REGION": "us-west-004"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "shoppersocean-preview-db",
        "database_id": "23076205-e4e7-498c-ab82-eb70ffcd17d8"
      }
    ]
  }
}
