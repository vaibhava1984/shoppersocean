{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shoppersocean",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "shoppersocean.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "B2_BUCKET": "Shoppers-ocean-books",
    "B2_ENDPOINT": "s3.us-west-004.backblazeb2.com",
    "B2_REGION": "us-west-004"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shoppers-ocean-db"
    }
  ],
  "preview": {
    "vars": {
      "ENVIRONMENT": "preview"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "shoppers-ocean-preview-db"
      }
    ]
  }
}
