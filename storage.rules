rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /protected-books/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.token.userrole == 'ADMIN';
    }
    match /covers/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.userrole == 'ADMIN';
    }
  }
}